# devhub telemetry 収集基盤(telemetry/docker-compose.yml)の環境変数テンプレート。
# このファイル自体はコミット対象(変数名のみ)。実値は telemetry/.env にコピーして書くこと。
# telemetry/.env はリポジトリの .gitignore の `.env` パターンで無視される(実値を残さない。NFR-1)。
#
# cp telemetry/.env.example telemetry/.env

# otel-collector の bearertokenauth extension(webhookevent receiver)が要求する Bearer トークン。
# devhub telemetry send 側 (DEVHUB_TELEMETRY_TOKEN) と同じ値を設定すること。
DEVHUB_TELEMETRY_TOKEN=

# Grafana 管理者初期パスワード(GF_SECURITY_ADMIN_PASSWORD)。空のままにしない。
DEVHUB_TELEMETRY_GRAFANA_ADMIN_PASSWORD=
